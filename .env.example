TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
DATABASE_URL=
APP_URL=http://localhost:3000
ADMIN_PASSWORD=
SESSION_SECRET=
DEMO_MODE=

# AI voice is opt-in. Existing browser dialing and SMS do not depend on these.
AI_VOICE_ENABLED=0
# Set production on the persistent gateway; Vercel uses VERCEL_ENV automatically.
AI_DEPLOYMENT_MODE=
# standalone for the Node process, or vercel to use existing Fluid Compute hosting.
# Vercel mode: wss://<APP_URL host>/api/twilio/ai/relay, maximum 240s per call.
AI_GATEWAY_MODE=standalone
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional Groq provider; keep its credential separate from OpenAI's.
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=
GROQ_API_KEY=
# Public TLS endpoint for the separate long-lived Node gateway; no query parameters.
AI_WEBSOCKET_PUBLIC_URL=wss://your-gateway.example.com/relay
AI_GATEWAY_PORT=3001
# Optional local-only upstream: one TLS tunnel can serve both the app and /relay.
AI_PROXY_APP_URL=
AI_GATEWAY_SECRET=
# Set only after accepting Twilio's AI/ML addendum and enabling ConversationRelay.
AI_CONVERSATION_RELAY_ACKNOWLEDGED=0
# Exact consented test destinations in E.164 format, comma-separated. Empty denies outbound.
AI_DEMO_ALLOWED_NUMBERS=
AI_HUMAN_TRANSFER_NUMBER=

# Optional actual Google Calendar integration (dedicated agency calendar).
# OAuth scopes: calendar.events and calendar.freebusy. Never paste tokens into the UI.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Rates, timestamped USD/INR conversion, budgets, retention and agent limits
# are editable in Calls → AI Agent. No permanent exchange rate is hardcoded.

# Monitoring & Usage Intelligence: additive Drizzle migration, same Neon database.
# Start npm run monitoring:worker on a long-lived Node host (15-second processing,
# bounded provider reconciliation every five minutes). No new provider keys.
MONITORING_RETENTION_DAYS=90
# Sourced, effective rates and timestamped INR conversions are configured in
# Monitoring → Costs. Missing quantities/prices/FX remain unavailable.
