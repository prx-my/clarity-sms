FROM node:22-bookworm-slim
ENV NODE_ENV=production AI_DEPLOYMENT_MODE=production AI_GATEWAY_PORT=3001
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY tsconfig.json ./
COPY scripts/voice-gateway.ts ./scripts/voice-gateway.ts
COPY src ./src
USER node
EXPOSE 3001
CMD ["npm", "run", "voice:start"]
